{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "promise", "import", "unicorn", "jsdoc", "vitest", "jsx-a11y"],
  "categories": { "correctness": "off" },
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "warn" },
  "env": { "browser": true, "node": true, "es2024": true },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/payload-types.ts",
    "**/*.d.ts",
    "**/*.d.ts.map",
    "**/.worktrees/**",
    "**/.claude/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/uploads/**",
    "**/*.min.js",
    "**/*.bundle.js",
    "**/app/(payload)/**",
    "**/importMap.js",
    "next-env.d.ts"
  ],
  "rules": {
    "constructor-super": "error",
    "for-direction": "error",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",

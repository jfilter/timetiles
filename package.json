{
  "name": "timetiles",
  "version": "0.0.1",
  "private": true,
  "description": "A data explorer for spatio-temporal data with custom metadata.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:eslint": "eslint --flag v10_config_lookup_from_file",
    "lint:scripts": "oxlint --config .oxlintrc.json scripts && pnpm lint:eslint scripts",
    "lint:devops": "actionlint -shellcheck= && find . -name 'Dockerfile*' ! -name '*.dockerignore' -type f | grep -v node_modules | grep -v .worktrees | grep -v .claude | xargs hadolint && find . \\( -name 'Makefile' -o -name '*.mk' \\) -type f | grep -v node_modules | grep -v .worktrees | grep -v .claude | xargs checkmake --config=.checkmake && find . -name '*.sh' -type f | grep -v node_modules | grep -v .worktrees | grep -v .claude | xargs shellcheck --exclude=SC1091,SC2016",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:merge": "tsx scripts/merge-coverage.ts",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsgo -p scripts/tsconfig.json",
    "check": "turbo run lint typecheck",
    "setup:git": "./scripts/setup-git.sh",
    "sonarcloud:fetch": "tsx scripts/fetch-sonarcloud-issues.ts",
    "sonarcloud:review": "tsx scripts/review-sonarcloud-hotspots.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@timetiles/eslint-config": "workspace:*",
    "@timetiles/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "beta",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "^1.73.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "nyc": "^18.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "~1.73.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "catalog:",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "pino": "^10.3.1",
      "@headlessui/react": "^2.2.6",
      "@theguild/remark-mermaid": "^0.0.7",
      "next-mdx-remote": "^5.0.0",
      "form-data": "^4.0.4",
      "cross-spawn": "^7.0.6",
      "dompurify": "^3.4.17",
      "esbuild": "^0.28.2",
      "undici@7": "^7.30.1",
      "immutable": "^4.3.8",
      "ws": "^8.20.1",
      "fast-uri": "^3.1.6",
      "postcss": "^8.5.30",
      "protocol-buffers-schema": "^3.6.1",
      "icu-minify": "^4.9.2",
      "@xmldom/xmldom": "^0.9.12",
      "picomatch@2": "^2.3.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "ajv@8": "^8.20.0",
      "uuid@11": "^11.1.1",
      "uuid@13": "^13.0.1",
      "yaml@2": "^2.8.3",
      "@payloadcms/email-nodemailer>nodemailer": "^10.2.1",
      "@lexical/headless>happy-dom": "^21.0.4",
      "nextra>zod": "^4.6.7",
      "nextra-theme-docs>zod": "^4.6.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "monaco-editor",
        "yjs",
        "puppeteer"
      ],
      "allowedVersions": {
        "@theguild/remark-mermaid>react": "^19",
        "@typescript-eslint/utils>eslint": "^9"
      }
    },
    "patchedDependencies": {
      "node-geocoder@4.4.1": "patches/node-geocoder@4.4.1.patch",
      "payload@3.90.2": "patches/payload@3.90.2.patch",
      "nextra-theme-docs@4.6.1": "patches/nextra-theme-docs@4.6.1.patch"
    }
  }
}

# Production Environment Configuration
# Copy this file to .env.production and fill in your values

# ==========================================
# Docker Compose Configuration
# ==========================================
# Project name (used for container names)
COMPOSE_PROJECT_NAME=timetiles

# Image configuration
# For production, use pre-built images from GitHub Container Registry
TIMETILES_IMAGE=ghcr.io/jfilter/timetiles
TIMETILES_VERSION=edge
# Pin to specific version for stability:
# TIMETILES_VERSION=1.0.0

# ==========================================
# Database Configuration
# ==========================================
DB_NAME=timetiles
DB_USER=timetiles_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Note: DB_PASSWORD must not contain @ : / % or other URI-special characters
# (it is interpolated into DATABASE_URL without encoding)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# PostgreSQL/PostGIS image configuration
# Default: kartoza/postgis (multi-arch: amd64 + arm64)
# For x86-only production servers, you can use: postgis/postgis
# POSTGRES_IMAGE=kartoza/postgis
POSTGRES_VERSION=17-3.5

# PostgreSQL tuning (optional - defaults are optimized for 2GB RAM)
# PG_MAX_LOCKS=1024
# PG_STACK_DEPTH=7680kB
# PG_WORK_MEM=32MB
# PG_SHARED_BUFFERS=256MB
# PG_MAX_CONNECTIONS=100
# PG_CACHE_SIZE=1GB
# PG_MAINTENANCE_MEM=128MB
# PG_LOG_STATEMENT=none

# ==========================================
# Payload CMS Configuration
# ==========================================
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_ME_RANDOM_32_CHAR_SECRET

# Your production domain (e.g., timetiles.example.com)
DOMAIN_NAME=your-domain.com
NEXT_PUBLIC_PAYLOAD_URL=https://${DOMAIN_NAME}

# ==========================================
# Application Settings
# ==========================================
NODE_ENV=production

# Surface-level deployment label, shown to visitors as a top banner when
# anything other than "production". Lets one Docker image serve as either
# staging or prod by flipping this single var.
# Allowed: production | staging | preview | development
DEPLOYMENT_ENVIRONMENT=production

# Auto-activate the data packages listed in
# apps/web/config/data-packages.activations.yml under the matching
# DEPLOYMENT_ENVIRONMENT key. Disable this to keep activations
# operator-driven only. Idempotent — already-activated packages are
# skipped.
RUN_AUTO_ACTIVATIONS=true

# Rate-limit backend. Accepted values are exactly "memory" and "pg" — anything
# else (e.g. "postgresql") is rejected by lib/services/rate-limit/factory.ts and
# silently falls back to "memory".
# - memory: single-web-instance deployments
# - pg: required before serving overlapping traffic from multiple web processes/containers
#
# WARNING: setting this here is NOT enough today. docker-compose.prod.yml has no
# `env_file:` and does not list RATE_LIMIT_BACKEND in the web/worker
# `environment:` blocks, so the value never reaches the container and the app
# always uses the in-memory store (per-process counters, empty pg table, nothing
# logged). Add `RATE_LIMIT_BACKEND: ${RATE_LIMIT_BACKEND:-memory}` to the
# `environment:` block of the web and worker services before relying on "pg".
RATE_LIMIT_BACKEND=memory

# Trusted reverse-proxy CIDRs (comma-separated). Required so rate limiting can
# identify real clients: in production the app trusts X-Forwarded-For / X-Real-IP
# only from hops inside this allowlist — otherwise every client is bucketed as
# "unknown". The compose default (172.16.0.0/12) covers the Docker bridge that
# nginx runs on. Add your edge/CDN ranges here if one fronts nginx.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Port configuration
HOST_PORT=3000          # Port exposed on host machine
CONTAINER_PORT=3000     # Port inside container

# Logging
LOG_LEVEL=info

# Host directory bind-mounted to /var/log/timetiles inside the web/worker
# containers (web.log, worker-*.log). Relative paths resolve against this
# compose file's directory. Bootstrap step 09 points logrotate at this path — if
# you change it AFTER bootstrap, re-run that step or /etc/logrotate.d/timetiles
# will keep rotating the old directory and the app logs will grow unbounded.
# LOG_HOST_DIR=./logs

# ==========================================
# Nginx & SSL Configuration
# ==========================================
# NGINX_VERSION=alpine
# HTTP_PORT=80
# HTTPS_PORT=443
# NGINX_CONF_PATH=./deployment/nginx/nginx.conf

# Email for Let's Encrypt notifications
LETSENCRYPT_EMAIL=admin@${DOMAIN_NAME}

# ==========================================
# Email Configuration (SMTP)
# ==========================================
# Needed for registration, password reset and account verification emails.
#
# Left unset on purpose: a placeholder host is worse than no host at all. The
# app treats any value here as a working mail server, so `smtp.example.com`
# made every send fail with ENOTFOUND — including the verification email that
# Payload sends while registering the very first admin, which left fresh
# deployments with no way to create one. Set this to a real server to enable
# email; leave it commented out to run without outgoing mail.
# EMAIL_SMTP_HOST=smtp.your-provider.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=noreply@${DOMAIN_NAME}
# Optional: SMTP authentication
# EMAIL_SMTP_USER=your-smtp-user
# EMAIL_SMTP_PASS=your-smtp-password
# Override the SNI / cert-validation hostname. Useful when EMAIL_SMTP_HOST
# is a private IP whose server cert names a public DNS name.
# EMAIL_SMTP_TLS_SERVERNAME=mail.example.com

# ==========================================
# File Upload Configuration
# ==========================================
# Host directory for uploads (bind-mounted into the container)
# Subfolders are created automatically: /media and /import-files
UPLOAD_HOST_DIR=./uploads
# Container-internal path (should not need changing)
UPLOAD_DIR=/app/apps/web/uploads

# Host directory for generated data exports. Shared on purpose: a worker
# writes the file, the web container serves the download from the stored
# absolute path, and the maintenance worker deletes it once it expires.
EXPORT_HOST_DIR=./exports

# ==========================================
# Application Config (Optional)
# ==========================================
# Directory containing timetiles.yml for rate limits, quotas, batch sizes.
# If absent, all defaults apply — no action needed.
#
# The value below suits a standalone deployment/ checkout. Bootstrap overrides
# it with ../apps/web/config on purpose (step 06), because that same mount also
# carries the bundled data-package manifests, which exist only there — pointing
# it at ./config would silently strip every one of them.
#
# So: on a bootstrapped host put your timetiles.yml in apps/web/config/ and copy
# the template from apps/web/config/timetiles.example.yml. On a compose-only
# deployment use ./config and deployment/config/timetiles.example.yml. The two
# templates are kept identical.
CONFIG_DIR=./config

# =============================================================================
# Scraper Runner Configuration (Optional)
# =============================================================================
# Enable to allow user-defined web scrapers in Podman containers.
# Requires Podman on the host — see bootstrap step 13-scraper-setup.

# URL where the web app reaches the scraper runner
# SCRAPER_RUNNER_URL=http://host.docker.internal:4000

# Shared API key (min 16 chars). Generate with: openssl rand -hex 32
# SCRAPER_API_KEY=

# Runner settings
# SCRAPER_PORT=4000
# SCRAPER_MAX_CONCURRENT=3
# SCRAPER_DEFAULT_TIMEOUT=300
# SCRAPER_DEFAULT_MEMORY=512

# GHCR images for scraper base containers (pulled into Podman)
# SCRAPER_PYTHON_IMAGE=ghcr.io/jfilter/timetiles-scraper-python:latest
# SCRAPER_NODE_IMAGE=ghcr.io/jfilter/timetiles-scraper-node:latest

# =============================================================================
# Backup Configuration
# =============================================================================

# Backup encryption password (KEEP THIS SECURE)
RESTIC_PASSWORD=

# Local backup repository
RESTIC_REPOSITORY=/opt/timetiles/backups/restic-repo

# Offsite S3-compatible storage (optional)
# RESTIC_OFFSITE_REPOSITORY=s3:s3.amazonaws.com/your-bucket/timetiles
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=

# Retention policy
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12

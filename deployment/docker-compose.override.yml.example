# Docker Compose Override for Local Builds
#
# Copy to docker-compose.override.yml to build locally instead of pulling from registry.
# Useful for development or customization.
#
# Usage:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   ./timetiles build
#   ./timetiles up

# All four app services must be listed. They only share an image *name* in
# docker-compose.prod.yml — there is no inheritance from `web` — so overriding
# web alone left worker-ingest, worker-general and worker-maintenance pinned to
# ${TIMETILES_IMAGE}:${TIMETILES_VERSION}. A "local build" then ran working-tree
# code in web and published code in every worker, and `docker compose ps` could
# not show it because it prints the tag, not the image ID.
#
# pull_policy: never belongs on all of them, web included: without it `up` is
# free to replace a locally built image with a pulled one. deployment/tests/
# run-vm.sh writes the same shape for the same reasons.
services:
  web:
    build:
      context: ..
      dockerfile: deployment/Dockerfile.prod
      args:
        # DATABASE_URL and PAYLOAD_SECRET are NOT passed here because:
        # 1. Dockerfile.prod already uses dummy defaults for build-time compilation
        # 2. Passing real secrets as build args exposes them in image layer metadata
        # 3. Real values are injected at runtime via environment variables
        NEXT_PUBLIC_PAYLOAD_URL: ${NEXT_PUBLIC_PAYLOAD_URL:-http://localhost:3000}
    image: timetiles-web:local
    pull_policy: never

  # The workers run the same image as web; only the command differs. They are
  # not rebuilt here — `./timetiles build` builds web, and these three reuse
  # that tag.
  worker-ingest:
    image: timetiles-web:local
    pull_policy: never

  worker-general:
    image: timetiles-web:local
    pull_policy: never

  worker-maintenance:
    image: timetiles-web:local
    pull_policy: never

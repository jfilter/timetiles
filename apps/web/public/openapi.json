                  "maxLength": 500
                },
                "maxItems": 100
              },
              "default": {}
            },
            "required": false,
            "name": "ff",
            "in": "query"
          },
          {
            "schema": {
              "type": "object",
              "nullable": true,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number",
                    "nullable": true
                  },
                  "max": {
                    "type": "number",
                    "nullable": true
                  }
                }
              },
              "default": {}
            },
            "required": false,
            "name": "rf",
            "in": "query"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "required": false,
            "name": "scopeCatalogs",
            "in": "query"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "required": false,
            "name": "scopeDatasets",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },

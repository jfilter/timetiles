          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "catalog",
            "in": "query"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "required": false,
            "name": "datasets",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date"
            },
            "required": false,
            "name": "startDate",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date"
            },
            "required": false,
            "name": "endDate",
            "in": "query"
          },
          {

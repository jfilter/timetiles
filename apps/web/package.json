{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "description": "The web application for TimeTiles, providing the main user interface and data exploration features.",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:debug": "LOG_LEVEL=debug next dev --turbopack",
    "build": "payload generate:types --silent && next build",
    "build:compile": "payload generate:types --silent && payload generate:importmap --silent && next build --experimental-build-mode compile",
    "start": "next start",
    "lint": "oxlint --config ../../.oxlintrc.json . && pnpm -w lint:eslint apps/web --cache --cache-location apps/web/.eslintcache",
    "format": "oxfmt --write .",
    "typecheck": "tsx ../../scripts/typecheck-with-json.ts",
    "check:ai": "tsx scripts/check-summary.ts",
    "payload": "payload",
    "payload:generate": "tsx scripts/generate-payload.ts",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "payload:validate": "tsx scripts/validate-types.ts",
    "seed": "dotenv -e ../../.env -e .env.local -- tsx scripts/seed.ts",
    "test": "vitest run",
    "test:ai": "tsx scripts/test-ai.ts",
    "test:silent": "vitest run --reporter=basic --silent",
    "test:debug": "LOG_LEVEL=debug vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage --coverage.reportOnFailure=true",
    "test:coverage:summary": "tsx scripts/coverage-summary.ts",
    "test:coverage:check": "tsx scripts/coverage-summary.ts --threshold 80",
    "setup:e2e-db": "dotenv -e .env.local -- tsx scripts/e2e-setup-database.ts",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug --headed",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "openapi:generate": "tsx scripts/generate-openapi.ts && oxfmt public/openapi.json",
    "demo-data": "dotenv -e ../../.env -e .env.local -- tsx scripts/load-demo-data.ts",
    "packages": "dotenv -e ../../.env -e .env.local -- tsx scripts/manage-packages.ts",
    "heal": "dotenv -e ../../.env -e .env.local -- tsx scripts/heal.ts",
    "setup-site": "dotenv -e ../../.env -e .env.local -- tsx scripts/setup-site.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@timetiles/assets": "workspace:*",
    "@timetiles/shared": "workspace:*",
    "@timetiles/typescript-config": "workspace:*",
    "@timetiles/ui": "workspace:*",
    "@types/archiver": "^8.0.0",
    "@types/node-geocoder": "^4.2.6",
    "@types/papaparse": "^5.5.2",
    "@xyflow/react": "^12.12.0",
    "archiver": "^8.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "chardet": "^2.2.0",
    "cheerio": "^1.2.0",
    "croner": "10.0.1",
    "expr-eval-fork": "^3.0.3",
    "franc": "catalog:",
    "graphql": "^16.14.2",
    "h3-js": "^4.5.0",
    "iconv-lite": "^0.7.3",
    "lucide-react": "catalog:",
    "maplibre-gl": "^6.14.0",
    "next": "catalog:",
    "next-intl": "^4.14.9",
    "next-themes": "catalog:",
    "node-geocoder": "^4.4.1",
    "nodemailer": "^9.0.3",
    "nuqs": "^2.10.2",
    "papaparse": "^5.7.0",
    "payload": "3.90.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.30",
    "postcss-safe-parser": "^7.1.0",
    "quicktype-core": "^25.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-map-gl": "^8.1.3",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "tsx": "catalog:",
    "undici": "^8.11.2",
    "uuid": "^14.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@timetiles/eslint-config": "workspace:*",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "echarts": "catalog:",
    "echarts-for-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-i18next": "^6.1.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

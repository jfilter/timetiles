{
  "name": "timescrape",
  "version": "0.0.1",
  "private": true,
  "description": "TimeScrape runner — executes user-defined scrapers in isolated Podman containers.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts && cp src/security/seccomp-profile.json dist/seccomp-profile.json",
    "start": "node dist/index.js",
    "lint": "oxlint --config ../../.oxlintrc.json . --ignore-pattern 'examples/**'",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:ai": "vitest run --reporter=json --outputFile=.test-results/latest.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@timetiles/shared": "workspace:*",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "simple-git": "^4.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@timetiles/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "pino-pretty": "^13.2.0",
    "tsup": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "catalog:"
  }
}

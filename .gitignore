# Build Outputs
.next/
out/
build
dist

# Generated raster exports; SVG files are the canonical logo sources.
packages/assets/logos/latest/**/png/

# TypeScript build artifacts
*.tsbuildinfo
# NOTE: packages/ui used to ignore compiled .js/.d.ts next to its sources.
# Those rules are gone on purpose -- tsc no longer emits there (noEmit in
# packages/ui/tsconfig.json), and hiding stray emits is what let 182 stale files
# shadow the .tsx sources in every local vitest run.

# Debug
npm-debug.log*
dev.log

# Misc
.DS_Store
*.pem

# Office temporary/lock files
.~lock.*#
~$*



